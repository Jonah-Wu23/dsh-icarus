{
  "name": "dsh-icarus",
  "version": "0.1.0",
  "private": true,
  "description": "Icarus: persistent commissions and evidence-backed curation on DeepSeek Harness",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./browser": "./lib/browser.js",
    "./fetch": "./lib/fetch.js",
    "./search": "./lib/search/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "NOTICE",
    "cordis.patch.yml"
  ],
  "bin": {
    "icarus-fetch": "./lib/fetch.js"
  },
  "meta": {
    "title": "Icarus",
    "description": "持续委托、预算管理与后台成果交付"
  },
  "scripts": {
    "build": "tsc && node build-client.mjs",
    "test": "node --test \"test/**/*.test.js\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-web": ">=0.2.0-rc.2 <0.2.1-0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/react": "18.3.1",
    "esbuild": "0.25.12",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@anweat/dsh-browser": "0.2.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "@mozilla/readability": "0.6.0",
    "fast-xml-parser": "5.11.2",
    "linkedom": "0.18.13",
    "markdown-it": "^15.0.2",
    "rss-parser": "3.13.0"
  }
}
